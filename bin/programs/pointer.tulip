#include "cstdlib.tulip"

int modify_value(*int v) {
    (*v)++;
}

int main(int argc, **char argv) {
    *int ptr = malloc(sizeof(int));

    *ptr = 67;

    printf("ptr = %p\n",   ptr);
    printf("*ptr = %d\n", *ptr);

    modify_value(ptr);

    printf("*ptr = %d\n", *ptr);

    free(ptr);

    return 0;
}
